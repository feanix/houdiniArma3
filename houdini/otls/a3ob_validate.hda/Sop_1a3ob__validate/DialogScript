# Dialog script for a3ob_validate, version 1

{
    name	a3ob_validate
    script	a3ob_validate
    label	"Validate"

    help {
	"Checks a P3D geometry or a LOD geometry the way the export does and shows what is wrong. Changes nothing. Shadow and underground LODs are always written with hard edges, so the message line says when the export will do that."
    }

    inputlabel	1	"P3D geometry or LOD geometry"

    group {
	name	"tab_checking"
	label	"Error Checking"

        parm {
    	name	"errorlevel"
    	label	"Errors Show As"
    	type	string
    	default	{ "error" }
    	menu {
    	    "error"	"Error (stop here)"
    	    "warning"	"Warning (keep geometry)"
    	}
    	help	"Error (stop here): the node turns red and the nodes below it stop. Warning (keep geometry): the node turns yellow and the geometry keeps flowing; the text still starts with Error:. Saving stops on errors either way."
        }

        parm {
    	name	"strict"
    	label	"Warnings Count As Errors"
    	type	toggle
    	default	{ "0" }
    	help	"Treat every warning as an error. Off by default: a warning can be what you meant."
        }

        parm {
    	name	"dupes"
    	label	"Duplicate LODs"
    	type	string
    	default	{ "fail" }
    	menu {
    	    "fail"	"Fail"
    	    "skip"	"Skip"
    	    "ignore"	"Ignore"
    	}
    	help	"What to do with a LOD whose type and resolution were already written: Fail, Skip the later one, or Ignore and write both."
        }

        parm {
    	name	"maxmessages"
    	label	"Max Messages"
    	type	integer
    	size	1
    	default	{ "25" }
    	range	{ 1! 10 }
    	help	"How many messages the node shows. The rest are counted in one line and listed in Windows > Log Viewer (source A3OB)."
        }
    }

    group {
	name	"tab_rules"
	label	"LOD Rules"

        parm {
    	name	"typerules"
    	label	"Check LOD-Type Rules"
    	type	toggle
    	default	{ "1" }
    	help	"Warn about what Object Builder's validator would: rules for geometry, shadow, roadway and other LOD types. Each rule has its own switch below."
        }

        parm {
    	name	"triangulate"
    	label	"Triangulate Where Needed"
    	type	toggle
    	default	{ "1" }
    	help	"Divide only the polygons that break the rules, in the written file (the geometry on the node is not changed): polygons with more than 4 points in any LOD, quads that are not convex in Geometry and Shadow Volume LODs, and every quad in Underground LODs. Triangles and allowed quads are left as they are. Uses Divide with Convex Polygons, Maximum Edges 3 and Avoid Small Angles, and warns for each LOD it changed. Off: those polygons stay and the checks report them."
        }

        parm {
    	name	"t2uv2"
    	label	"At most 2 UV sets"
    	type	toggle
    	default	{ "1" }
    	help	"The LOD has no more than 2 UV sets."
        }

        parm {
    	name	"t2contig"
    	label	"Contiguous mesh"
    	type	toggle
    	default	{ "1" }
    	help	"Geometry, shadow and underground LODs: no flipped polygons (shared edges run in opposite directions)."
        }

        parm {
    	name	"t2tri"
    	label	"Triangulated"
    	type	toggle
    	default	{ "1" }
    	help	"Underground LODs: every polygon is a triangle. Geometry and shadow LODs: triangles and convex quads."
        }

        parm {
    	name	"t2convex"
    	label	"Convex mesh"
    	type	toggle
    	default	{ "1" }
    	help	"Geometry and underground LODs: every shared edge is convex or flat."
        }

        parm {
    	name	"t2comp"
    	label	"Component selections"
    	type	toggle
    	default	{ "1" }
    	help	"Geometry and underground LODs: a group called component01, component02, ... exists."
        }

        parm {
    	name	"t2mass"
    	label	"Mass is set"
    	type	toggle
    	default	{ "1" }
    	help	"Geometry LOD: a note (not a warning) when the points have a total mass below 0.001."
        }

        parm {
    	name	"t2massall"
    	label	"Every point has mass"
    	type	toggle
    	default	{ "1" }
    	help	"Geometry LOD: every point has a mass of at least 0.001."
        }

        parm {
    	name	"t2nomat"
    	label	"No materials"
    	type	toggle
    	default	{ "1" }
    	help	"Underground LODs: no polygon has a texture or material. Shadow LODs may have them."
        }

        parm {
    	name	"t2shadowres"
    	label	"Conventional shadow resolution"
    	type	toggle
    	default	{ "0" }
    	help	"Shadow LODs: the resolution is 0, 10, 1000, 1010 or 1020. Off by default."
        }

        parm {
    	name	"t2shadowoff"
    	label	"Shadow not disabled"
    	type	toggle
    	default	{ "0" }
    	help	"Shadow LODs: no LODNoShadow = 1 property. Off by default."
        }

        parm {
    	name	"t2pcedge"
    	label	"No edges in point clouds"
    	type	toggle
    	default	{ "1" }
    	help	"Memory, land contact and hit-point LODs: no 2-point primitives."
        }

        parm {
    	name	"t2pcface"
    	label	"No faces in point clouds"
    	type	toggle
    	default	{ "1" }
    	help	"Memory, land contact and hit-point LODs: no polygons."
        }

        parm {
    	name	"t2rwfaces"
    	label	"Has polygons"
    	type	toggle
    	default	{ "1" }
    	help	"Roadway, ground layer and paths LODs: at least one polygon."
        }

        parm {
    	name	"t2rwlimit"
    	label	"Roadway point limit"
    	type	toggle
    	default	{ "1" }
    	help	"Roadway LODs: at most 255 points."
        }

        parm {
    	name	"t2rwsound"
    	label	"Roadway sound textures"
    	type	toggle
    	default	{ "1" }
    	help	"Roadway LODs: every polygon has a texture (the sound)."
        }

        parm {
    	name	"t2gluv"
    	label	"Ground layer UV set"
    	type	toggle
    	default	{ "1" }
    	help	"Ground layer LODs: exactly one UV set."
        }

        parm {
    	name	"t2gluvvalues"
    	label	"Ground layer UV values"
    	type	toggle
    	default	{ "1" }
    	help	"Ground layer LODs: every UV is (0, 0), (1, 0), (1, 1) or (1, -1)."
        }

        parm {
    	name	"t2pathentry"
    	label	"Path entry points"
    	type	toggle
    	default	{ "1" }
    	help	"Paths LODs: a group called in01, in02, ... exists."
        }

        parm {
    	name	"t2pathpos"
    	label	"Path position points"
    	type	toggle
    	default	{ "1" }
    	help	"Paths LODs: the same test as the entry rule (as in Object Builder, which tests entry points twice)."
        }

        parm {
    	name	"t2wgt4"
    	label	"At most 4 bones per point"
    	type	toggle
    	default	{ "1" }
    	help	"Visual, view and shadow LODs with selections named like the bones of the Arma 3 man skeleton (OFP2_ManSkeleton, case ignored): no point is weighted to more than 4 bones."
        }

        parm {
    	name	"t2wgtsum"
    	label	"Bone weights add up to 1"
    	type	toggle
    	default	{ "1" }
    	help	"The same LODs: the bone weights of a point add up to 1, within one 1/254 step."
        }

        parm {
    	name	"t2wgtnone"
    	label	"Every point has a bone weight"
    	type	toggle
    	default	{ "1" }
    	help	"The same LODs: every point has a weight in at least one bone selection."
        }
    }

}
