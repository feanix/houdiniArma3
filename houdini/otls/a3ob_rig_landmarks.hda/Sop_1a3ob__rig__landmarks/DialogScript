    parm {
	name	"ankle_l"
	label	"Left Ankle"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The left ankle joint, in the middle of the leg. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
