    parm {
	name	"thumb_l"
	label	"Left Thumb"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The left thumb, its last joint: inside the tip of the thumb. With the wrist and the middle finger it says which way the palm faces. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
