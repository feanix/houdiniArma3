# Dialog script for a3ob_rig_landmarks, version 1

{
    name	a3ob_rig_landmarks
    script	a3ob_rig_landmarks
    label	"Rig Landmarks"

    help {
	"Places the landmarks of your character (chin, groin, shoulders, elbows, wrists, hips, knees, ankles, middle fingers, thumbs) for Rig Fit, as positions that you drag in the viewport."
    }

    inputlabel	1	"Your mesh"
    inputlabel	2	"Skeleton"
    inputlabel	3	"Sample body"

    parm {
	name	"guess"
	label	"Guess Landmarks"
	type	button
	default	{ "0" }
	help	"Fills all 18 positions with the auto-guess of Rig Fit for your mesh. Connect the skeleton to input 2 and the sample body to input 3 first. It replaces the positions that are set."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'guess', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"mirror"
	label	"Mirror"
	type	toggle
	default	{ "1" }
	help	"Left is the +X side. On: the right landmarks follow the left ones, mirrored about the X = 0 plane, so dragging a left marker moves its right partner, and the right fields cannot be edited. Off: both sides are free."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'mirror_changed', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"chin"
	label	"Chin"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The tip of the chin on the middle line: the lowest point of the chin that faces forward (not the throat under it). The head joint is placed from it. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"groin"
	label	"Groin"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The crotch, the highest point between the legs. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark. In the viewport it is an upside-down V (wireframe, the apex is the landmark): push it up into the gap between the thighs until it sits snug against both inner thighs."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"shoulder_l"
	label	"Left Shoulder"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The left shoulder joint, inside the upper arm where it meets the body. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"shoulder_r"
	label	"Right Shoulder"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The right shoulder joint. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark. While Mirror is on this one follows the left side and cannot be edited."
	disablewhen	"{ mirror != 0 }"
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
