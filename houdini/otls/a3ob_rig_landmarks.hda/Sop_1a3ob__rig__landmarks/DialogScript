	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"hip_l"
	label	"Left Hip"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The left hip joint, inside the top of the thigh. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark. In the viewport it is a short wireframe cylinder, the top of the thigh, aimed at the knee: put its centre in the middle of the thigh top."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
