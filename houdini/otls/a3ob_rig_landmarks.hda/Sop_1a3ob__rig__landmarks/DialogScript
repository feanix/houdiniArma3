	name	"thumb_r"
	label	"Right Thumb"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"The right thumb, its last joint. Its position (X, Y, Z). Drag its marker in the viewport (select the node, move the mouse over the viewport and press Enter), type the numbers, or use Guess Landmarks. All zero means not set: Rig Fit then guesses this landmark. While Mirror is on this one follows the left side and cannot be edited."
	disablewhen	"{ mirror != 0 }"
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'moved', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"leftToRight"
	label	"Match Left to Right"
	type	button
	default	{ "0" }
	help	"Once: puts each right landmark at the mirror image of its left partner (mirrored about X = 0, Left is +X). Chin and groin stay as they are, and a left landmark that is not set is skipped. Disabled while Mirror is on, because the right side already follows the left."
	disablewhen	"{ mirror != 0 }"
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'left_to_right', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"rightToLeft"
	label	"Match Right to Left"
	type	button
	default	{ "0" }
	help	"Once: puts each left landmark at the mirror image of its right partner (mirrored about X = 0, Left is +X). Chin and groin stay as they are, and a right landmark that is not set is skipped. With Mirror on, the right side then follows the new left side."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'right_to_left', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"which"
	label	"Landmark"
	type	string
	default	{ "chin" }
	menu {
	    "chin"	"Chin"
	    "groin"	"Groin"
	    "shoulder_l"	"Left Shoulder"
	    "shoulder_r"	"Right Shoulder"
	    "elbow_l"	"Left Elbow"
	    "elbow_r"	"Right Elbow"
	    "wrist_l"	"Left Wrist"
	    "wrist_r"	"Right Wrist"
	    "hip_l"	"Left Hip"
	    "hip_r"	"Right Hip"
	    "knee_l"	"Left Knee"
	    "knee_r"	"Right Knee"
	    "ankle_l"	"Left Ankle"
	    "ankle_r"	"Right Ankle"
	    "finger_l"	"Left Finger"
	    "finger_r"	"Right Finger"
	    "thumb_l"	"Left Thumb"
	    "thumb_r"	"Right Thumb"
	}
	help	"The landmark that the two buttons below work on."
    }
    parm {
	name	"guessone"
	label	"Guess This Landmark"
	type	button
	default	{ "0" }
	help	"Puts the landmark chosen above back to its auto-guess (needs inputs 2 and 3 like Guess Landmarks). With Mirror on, its partner follows."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'guessone', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"fromsel"
	label	"Set From Selected Points"
	type	button
	default	{ "0" }
	help	"Puts the landmark chosen above at the average of the points that are selected in the viewport. Only the position is kept, not the selection. Useful for the chin and the groin. With Mirror on, its partner follows."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('rig_landmarks', 'fromsel', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
