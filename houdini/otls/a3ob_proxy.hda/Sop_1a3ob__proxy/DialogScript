# Dialog script for a3ob_proxy, version 1

{
    name	a3ob_proxy
    script	a3ob_proxy
    label	"Proxy"

    help {
	"Adds proxies (references to other .p3d files, such as weapon slots or seats) as packed primitives."
    }

    inputlabel	1	"LOD geometry"
    inputlabel	2	"Points (one proxy per point)"

    parm {
	name	"path"
	label	"Path"
	type	file
	default	{ "" }
	help	"The proxy model: pick a .p3d file, or type its game path, for example \\a3\\data_f\\proxies\\weapon_slots\\top. A picked file such as P:\\a3\\data_f\\proxies\\weapon_slots\\top.p3d gives the same name as typing it. Slashes become backslashes and the .p3d ending is removed. When you export with Relative Paths on, the path is made relative to the project root."
	parmtag	{ "filechooser_mode" "read" }
	parmtag	{ "filechooser_pattern" "*.p3d" }
    }
    parm {
	name	"common"
	label	"Common Proxies"
	type	string
	default	{ "none" }
	menu {
	    "none"	"(choose)"
	    "weapon_optic"	"Weapon: optic"
	    "weapon_pointer"	"Weapon: pointer"
	    "weapon_suppressor"	"Weapon: suppressor"
	    "weapon_magazine"	"Weapon: magazine"
	    "weapon_bipod"	"Weapon: bipod"
	    "driver_offroad"	"Driver: offroad"
	    "passenger_offroad"	"Passenger: offroad"
	    "gunner_hunter"	"Gunner: hunter"
	    "commander_hunter"	"Commander: hunter"
	    "light_volume_car"	"Light volume: car"
	}
	help	"Fills Path with the game path of a frequently used proxy, such as a weapon slot or a seat."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('proxy', 'fillcommon', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"index"
	label	"Index"
	type	integer
	size	1
	default	{ "1" }
	range	{ 0! 999! }
	help	"The proxy number, 0 to 999. The game needs a different number for each proxy with the same model in one LOD."
    }
    parm {
	name	"autoindex"
	label	"Number From Points"
	type	toggle
	default	{ "1" }
	help	"With a second input: the first proxy gets Index, the next one Index + 1, and so on. Off: all get Index."
    }
    parm {
	name	"t"
	label	"Translate"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"Where the proxy goes, in metres. Used when there is no second input."
    }
    parm {
	name	"r"
	label	"Rotate"
	type	vector
	size	3
	default	{ "0.0" "0.0" "0.0" }
	help	"How the proxy is turned, in degrees around X, Y and Z. A proxy has no scale."
    }
    parm {
	name	"useorient"
	label	"Orient From Points"
	type	toggle
	default	{ "1" }
	help	"With a second input: turn each proxy by the orient attribute of its point, if the point has one."
    }
}
