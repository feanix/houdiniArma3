# Dialog script for a3ob_p3d_import, version 1

{
    name	a3ob_p3d_import
    script	a3ob_p3d_import
    label	"P3D Import"

    help {
	"Reads an Arma 3 .p3d file (MLOD) and outputs one packed primitive per LOD."
    }

    parm {
	name	"file"
	label	"File"
	type	file
	default	{ "" }
	help	"The .p3d model to open. Use the editable version Object Builder saves (MLOD). Files taken out of the game's packed PBOs (binarized, ODOL) can't be opened."
	parmtag	{ "filechooser_mode" "read" }
	parmtag	{ "filechooser_pattern" "*.p3d" }
    }
    parm {
	name	"reload"
	label	"Reload"
	type	button
	default	{ "0" }
	help	"Read the file again from disk, for example after you saved it in Object Builder."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('p3d_import', 'reload', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"lods"
	label	"LODs"
	type	string
	default	{ "*" }
	menutoggle {
	    [ "__import__('a3ob_houdini.entry', fromlist=['menu']).menu('p3d_import', 'lod_choices', kwargs)" ]
	    language python
	}
	help	"Which LODs to bring in. Pick them from the menu, or type numbers or names. * means all. Picking from the menu replaces a * in the field, and a * next to other entries still means all."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('p3d_import', 'lods_changed', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"facegroups"
	label	"Explicit Face Groups"
	type	toggle
	default	{ "0" }
	help	"A face group is a named set of faces. Every selection comes in as a group of points. Normally a face group is added only when the selection's faces are not just the faces whose points are all in it. Turn this on to get a face group for every selection, for example when you want to select or blast faces by selection name."
    }
}
