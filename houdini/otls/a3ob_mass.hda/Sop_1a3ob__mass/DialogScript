# Dialog script for a3ob_mass, version 1

{
    name	a3ob_mass
    script	a3ob_mass
    label	"Mass"

    help {
	"Sets the mass of each point of a Geometry LOD (the #Mass# data of the P3D file)."
    }

    inputlabel	1	"LOD geometry"

    parm {
	name	"mode"
	label	"Mode"
	type	string
	default	{ "total" }
	menu {
	    "each"	"Set on each"
	    "total"	"Uniform total"
	    "density"	"From density"
	    "clear"	"Clear"
	    "copyfrom"	"Copy from mass"
	    "copyto"	"Copy to mass"
	}
	help	"How the mass is set. Only the number for the chosen way is shown."
    }
    parm {
	name	"mass_each"
	label	"Mass per Point (kg)"
	type	float
	size	1
	default	{ "1.0" }
	range	{ 0! 10 }
	help	"The mass in kilograms that every point gets. It cannot be below 0. The slider shows 0 to 10, and you can type a larger number."
	hidewhen	"{ mode != each }"
    }
    parm {
	name	"mass_total"
	label	"Total Mass (kg)"
	type	float
	size	1
	default	{ "1.0" }
	range	{ 0! 10 }
	help	"The mass in kilograms of the whole object. It is shared equally among the points. It cannot be below 0. The slider shows 0 to 10, and you can type a larger number."
	hidewhen	"{ mode != total }"
    }
    parm {
	name	"density"
	label	"Density (kg/m³)"
	type	float
	size	1
	default	{ "1.0" }
	range	{ 0! 10 }
	help	"The mass of one cubic metre of the material, in kilograms. Each closed shape gets its volume times this number. It cannot be below 0. The slider shows 0 to 10, and you can type a larger number."
	hidewhen	"{ mode != density }"
    }
    parm {
	name	"value"
	label	"Value (old scenes)"
	type	float
	size	1
	default	{ "-1.0" }
	help	"Not shown. Scenes saved before the three mass parameters existed stored the number here. When a scene loads, a number of 0 or more is moved into the parameter of the current mode and this goes back to -1. A new node leaves it at -1."
	invisible
    }
    parm {
	name	"group"
	label	"Group"
	type	string
	default	{ "" }
	menutoggle {
	    [ "__import__('a3ob_houdini.entry', fromlist=['group_menu']).group_menu('mass', 'group', kwargs)" ]
	    language python
	}
	help	"The points to change. Empty means all points. A point group or a primitive group (its primitives' points count) works. The menu lists your point and primitive groups of the input and shows the P3D name of a selection; picking adds or removes the group. The arrow button picks points in the viewport. You can also type group names, patterns or point numbers (for example 0-3)."
	parmtag	{ "script_action" "import hou\nimport soputils\nkwargs['geometrytype'] = [hou.geometryType.Points]\nkwargs['inputindex'] = 0\nsoputils.selectGroupParm(kwargs)" }
	parmtag	{ "script_action_help" "Select geometry from an available viewport.\nShift-click to turn on Select Groups." }
	parmtag	{ "script_action_icon" "BUTTONS_reselect" }
    }
    parm {
	name	"visualize"
	label	"Visualize"
	type	toggle
	default	{ "0" }
	help	"Colour the points in the viewport by their mass: blue is the least mass, red the most, black no mass. This is a node visualizer, so the geometry (and any Cd it has) is not changed. The export ignores it. The Visualize colours show only when the Visualization button on the right toolbar of the viewport is on."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('mass', 'visualize', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
}
