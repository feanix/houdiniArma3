# Dialog script for a3ob_material_assign, version 1

{
    name	a3ob_material_assign
    script	a3ob_material_assign
    label	"Material Assign"

    help {
	"Sets the texture and the material (rvmat) of the polygons in a group, or of all polygons."
    }

    inputlabel	1	"LOD geometry"

    parm {
	name	"group"
	label	"Group"
	type	string
	default	{ "" }
	help	"Which polygons to set. Empty means all polygons. Normal Houdini group syntax; a selection with an encoded name is easiest to pick in the Selection browser."
    }
    parm {
	name	"grouptype"
	label	"Group Type"
	type	string
	default	{ "prims" }
	menu {
	    "prims"	"Primitives"
	    "points"	"Points"
	}
	help	"Primitives: the polygons in the group. Points: the polygons whose points are all in the group."
    }
    parm {
	name	"settex"
	label	"Set Texture"
	type	toggle
	default	{ "1" }
	help	"Off: leave a3ob_texture as it is."
    }
    parm {
	name	"texsource"
	label	"Texture Source"
	type	string
	default	{ "file" }
	menu {
	    "file"	"File"
	    "color"	"Color"
	    "custom"	"Custom"
	}
	help	"Where the texture text comes from."
    }
    parm {
	name	"texture"
	label	"Texture File"
	type	string
	default	{ "" }
	help	"For File. Slashes are written as backslashes."
    }
    parm {
	name	"color"
	label	"Color"
	type	float
	size	4
	default	{ "1.0" "1.0" "1.0" "1.0" }
	help	"For Color. Red, green, blue and alpha, 0 to 1."
    }
    parm {
	name	"colortype"
	label	"Color Type"
	type	string
	default	{ "CO" }
	menu {
	    "CO"	"CO - Color Value"
	    "CA"	"CA - Texture with Alpha"
	    "LCO"	"LCO - Terrain Texture Layer Color"
	    "SKY"	"SKY - Sky texture"
	    "NO"	"NO - Normal Map"
	    "NS"	"NS - Normal map specular with Alpha"
	    "NOF"	"NOF - Normal map faded"
	    "NON"	"NON - Normal map noise"
	    "NOHQ"	"NOHQ - Normal map High Quality"
	    "NOPX"	"NOPX - Normal Map with paralax"
	    "NOVHQ"	"NOVHQ - two-part DXT5 compression"
	    "DT"	"DT - Detail Texture"
	    "CDT"	"CDT - Colored detail texture"
	    "MCO"	"MCO - Multiply color"
	    "DTSMDI"	"DTSMDI - Detail SMDI map"
	    "MC"	"MC - Macro Texture"
	    "AS"	"AS - Ambient Shadow texture"
	    "ADS"	"ADS - Ambient Shadow in Blue"
	    "PR"	"PR - Ambient shadow from directions"
	    "SM"	"SM - Specular Map"
	    "SMDI"	"SMDI - Specular Map, optimized"
	    "MASK"	"MASK - Mask for multimaterial"
	    "TI"	"TI - Thermal imaging map"
	}
	help	"For Color. The kind of procedural texture."
    }
    parm {
	name	"raw"
	label	"Raw Text"
	type	string
	default	{ "" }
	help	"For Custom. Copied exactly as typed."
    }
    parm {
	name	"commonproc"
	label	"Common Procedural"
	type	string
	default	{ "none" }
	menu {
	    [ "__import__('a3ob_houdini.entry', fromlist=['menu']).menu('material_assign', 'commonproc', kwargs)" ]
	    language python
	}
	help	"Fill Raw Text from the common procedural textures (and switch Texture Source to Custom). Add your own in the common data file of the Project root and presets tool."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('material_assign', 'fillproc', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"setmat"
	label	"Set Material"
	type	toggle
	default	{ "1" }
	help	"Off: leave a3ob_material as it is."
    }
    parm {
	name	"material"
	label	"Material File"
	type	string
	default	{ "" }
	help	"The rvmat path. Empty clears the material. Slashes are written as backslashes."
    }
    parm {
	name	"commonmat"
	label	"Add Common"
	type	string
	default	{ "none" }
	menu {
	    [ "__import__('a3ob_houdini.entry', fromlist=['menu']).menu('material_assign', 'commonmat', kwargs)" ]
	    language python
	}
	help	"Fill Material File from the common materials (and switch Set Material on). Add your own in the common data file of the Project root and presets tool."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('material_assign', 'fillmat', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
}
