# Dialog script for a3ob_rig_fit, version 1

{
    name	a3ob_rig_fit
    script	a3ob_rig_fit
    label	"Rig Fit"

    help {
	"Fits the Arma skeleton and the sample body to your mesh, from landmarks that you set or that are guessed."
    }

    inputlabel	1	"Your mesh"
    inputlabel	2	"Skeleton"
    inputlabel	3	"Sample body"

    parm {
	name	"show"
	label	"Show"
	type	string
	default	{ "all" }
	menu {
	    "all"	"All"
	    "skeleton"	"Fitted skeleton"
	    "body"	"Fitted sample body"
	    "landmarks"	"Landmarks"
	}
	help	"Which results are drawn in the viewport. The node always gives all results as one geometry, packed primitives named by the prim string a3ob_rig_part (a fourth, rest_body, the sample body as it came in, is never drawn; Unpose uses it). This menu only hides the others from view; the output is the same for every choice. Weight Transfer takes the fitted sample body from it by itself."
    }
    parm {
	name	"landmarks"
	label	"Landmarks"
	type	string
	default	{ "both" }
	menu {
	    "guess"	"Auto-guess"
	    "landmarks"	"From Rig Landmarks"
	    "both"	"Both"
	}
	help	"Where the landmarks come from: the chin, the groin and the shoulder, elbow, wrist, hip, knee, ankle, middle finger and thumb of each side. The Rig Landmarks node in front of this one holds the positions you placed (its markers are dragged in the viewport). Left is the +X side."
    }
    parm {
	name	"snap"
	label	"Snap to Surface"
	type	toggle
	default	{ "1" }
	help	"Move the chin and the groin onto the closest point of your mesh. The joints lie inside the body and are never moved."
    }
    parm {
	name	"symmetry"
	label	"Symmetry"
	type	toggle
	default	{ "1" }
	help	"Make the left and right landmarks mirror each other. When both sides of a pair are set in Rig Landmarks they are averaged; when only one side is, the other side is its mirror image."
    }
    parm {
	name	"refine"
	label	"Refine"
	type	toggle
	default	{ "1" }
	help	"Wrap the fitted sample body onto your bare body with Topo Transfer, so it takes your proportions. Each landmark is moved to the closest point of the sample body and of your body; the pairs with the same name guide the wrap. The heel and the toe tip of each foot are found on both bodies by themselves and guide it too, and the lower part of each wrapped foot is then laid on your sole, so the feet end where yours end and stand flat. The fitted sample body part becomes the wrapped body, with its bone weights. Off: the sample body is only posed and sized."
    }
    parm {
	name	"bodygroup"
	label	"Body Group"
	type	string
	default	{ "body" }
	menutoggle {
	    [ "__import__('a3ob_houdini.entry', fromlist=['group_menu']).group_menu('rig_fit', 'bodygroup', kwargs)" ]
	    language python
	}
	help	"The point group of your mesh that Refine wraps onto: the bare body, without hair, helmet or other accessories. Empty means the whole mesh."
	parmtag	{ "script_action" "import hou\nimport soputils\nkwargs['geometrytype'] = [hou.geometryType.Points]\nkwargs['inputindex'] = 0\nsoputils.selectGroupParm(kwargs)" }
	parmtag	{ "script_action_help" "Select geometry from an available viewport.\nShift-click to turn on Select Groups." }
	parmtag	{ "script_action_icon" "BUTTONS_reselect" }
    }
    parm {
	name	"scale"
	label	"Scale"
	type	string
	default	{ "bone" }
	menu {
	    "bone"	"Per bone length"
	    "body"	"Whole body"
	}
	help	"How the length of each bone is fitted."
    }
}
