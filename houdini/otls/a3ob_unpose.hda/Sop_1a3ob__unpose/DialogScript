# Dialog script for a3ob_unpose, version 1

{
    name	a3ob_unpose
    script	a3ob_unpose
    label	"Unpose"

    help {
	"Moves your weighted mesh from the pose of the fitted skeleton back onto the Arma rest pose."
    }

    inputlabel	1	"Your mesh"
    inputlabel	2	"Fitted skeleton"
    inputlabel	3	"Arma skeleton"

    parm {
	name	"rigid_pieces"
	label	"Rigid Pieces Keep Their Shape"
	type	toggle
	default	{ "1" }
	help	"Move all the points of a rigid piece (made by Accessory Weights in Rigid mode) with one matrix, so the piece keeps its shape. Off: every point uses its own weights, which can stretch a rigid piece when its bone bends."
    }
    parm {
	name	"group"
	label	"Group"
	type	string
	default	{ "" }
	menutoggle {
	    [ "__import__('a3ob_houdini.entry', fromlist=['group_menu']).group_menu('unpose', 'group', kwargs)" ]
	    language python
	}
	help	"The points to unpose. Empty means all points. The menu lists the point groups of the input and shows the P3D name of a selection; picking adds or removes the group. The arrow button picks points in the viewport. You can also type group names, patterns or point numbers (for example 0-3)."
	parmtag	{ "script_action" "import hou\nimport soputils\nkwargs['geometrytype'] = [hou.geometryType.Points]\nkwargs['inputindex'] = 0\nsoputils.selectGroupParm(kwargs)" }
	parmtag	{ "script_action_help" "Select geometry from an available viewport.\nShift-click to turn on Select Groups." }
	parmtag	{ "script_action_icon" "BUTTONS_reselect" }
    }
}
