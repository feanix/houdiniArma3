# Dialog script for a3ob_unpose, version 1

{
    name	a3ob_unpose
    script	a3ob_unpose
    label	"Unpose"

    help {
	"Moves your weighted mesh from the pose of the fitted skeleton back onto the Arma rest pose, by a cage from your body to the sample body."
    }

    inputlabel	1	"Your mesh"
    inputlabel	2	"Fitted skeleton"
    inputlabel	3	"Arma skeleton"

    parm {
	name	"method"
	label	"Method"
	type	string
	default	{ "cage" }
	menu {
	    "cage"	"Cage"
	    "bones"	"Bones"
	}
	help	"How the points move back to the Arma rest pose. Neither method changes the overall size."
    }
    parm {
	name	"bodygroup"
	label	"Body Group"
	type	string
	default	{ "body" }
	menutoggle {
	    [ "__import__('a3ob_houdini.entry', fromlist=['group_menu']).group_menu('unpose', 'bodygroup', kwargs)" ]
	    language python
	}
	help	"Cage method: the point group of your mesh that is the bare body, the one Rig Fit wrapped onto. Its points always follow the cage. A piece outside it whose points follow one bone only (a helmet) is moved as a rigid piece; other points outside it (clothes that bend) keep their distance from the closest point of the wrapped body and move with that place of its surface. Empty means the whole mesh is body."
	parmtag	{ "script_action" "import hou\nimport soputils\nkwargs['geometrytype'] = [hou.geometryType.Points]\nkwargs['inputindex'] = 0\nsoputils.selectGroupParm(kwargs)" }
	parmtag	{ "script_action_help" "Select geometry from an available viewport.\nShift-click to turn on Select Groups." }
	parmtag	{ "script_action_icon" "BUTTONS_reselect" }
    }
    parm {
	name	"rigid_pieces"
	label	"Rigid Pieces Keep Their Shape"
	type	toggle
	default	{ "1" }
	help	"Move all the points of a rigid piece (made by Accessory Weights in Rigid mode, or an island outside the Body Group that follows one bone only) with one rigid transform, so the piece keeps its shape. Off: every point follows the cage (or its own weights in the Bones method), which can stretch a rigid piece."
    }
    parm {
	name	"group"
	label	"Group"
	type	string
	default	{ "" }
	menutoggle {
	    [ "__import__('a3ob_houdini.entry', fromlist=['group_menu']).group_menu('unpose', 'group', kwargs)" ]
	    language python
	}
	help	"The points to unpose. Empty means all points. The menu lists the point groups of the input and shows the P3D name of a selection; picking adds or removes the group. The arrow button picks points in the viewport. You can also type group names, patterns or point numbers (for example 0-3)."
	parmtag	{ "script_action" "import hou\nimport soputils\nkwargs['geometrytype'] = [hou.geometryType.Points]\nkwargs['inputindex'] = 0\nsoputils.selectGroupParm(kwargs)" }
	parmtag	{ "script_action_help" "Select geometry from an available viewport.\nShift-click to turn on Select Groups." }
	parmtag	{ "script_action_icon" "BUTTONS_reselect" }
    }
}
