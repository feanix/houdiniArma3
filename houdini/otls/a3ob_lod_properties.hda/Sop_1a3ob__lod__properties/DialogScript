# Dialog script for a3ob_lod_properties, version 1

{
    name	a3ob_lod_properties
    script	a3ob_lod_properties
    label	"LOD Properties"

    help {
	"Sets the LOD type, resolution, named properties and LOD copies of a LOD geometry."
    }

    inputlabel	1	"LOD geometry"

    parm {
	name	"fromin"
	label	"Read from Input"
	type	button
	default	{ "0" }
	help	"Copy the type, resolution, properties and copies of the input into the parameters below. Use it right after Extract LOD."
	parmtag	{ "script_callback" "import a3ob_houdini.entry as e; e.button('lod_properties', 'fromin', kwargs)" }
	parmtag	{ "script_callback_language" "python" }
    }
    parm {
	name	"settype"
	label	"Set Type and Resolution"
	type	toggle
	default	{ "1" }
	help	"Off: leave the input's type and resolution alone and only edit properties and copies."
    }
    parm {
	name	"lodtype"
	label	"LOD Type"
	type	string
	default	{ "visual" }
	menu {
	    "visual"	"Resolution"
	    "view_gunner"	"View - Gunner"
	    "view_pilot"	"View - Pilot"
	    "view_cargo"	"View - Cargo"
	    "shadow"	"Shadow Volume"
	    "edit"	"Edit"
	    "geometry"	"Geometry"
	    "geometry_buoy"	"Geometry Buoyancy"
	    "geometry_physx"	"Geometry PhysX"
	    "memory"	"Memory"
	    "landcontact"	"Land Contact"
	    "roadway"	"Roadway"
	    "paths"	"Paths"
	    "hitpoints"	"Hit-points"
	    "view_geometry"	"View Geometry"
	    "fire_geometry"	"Fire Geometry"
	    "view_cargo_geometry"	"View - Cargo Geometry"
	    "view_cargo_fire_geometry"	"View - Cargo Fire Geometry"
	    "view_commander"	"View - Commander"
	    "view_commander_geometry"	"View - Commander Geometry"
	    "view_commander_fire_geometry"	"View - Commander Fire Geometry"
	    "view_pilot_geometry"	"View - Pilot Geometry"
	    "view_pilot_fire_geometry"	"View - Pilot Fire Geometry"
	    "view_gunner_geometry"	"View - Gunner Geometry"
	    "view_gunner_fire_geometry"	"View - Gunner Fire Geometry"
	    "subparts"	"Sub Parts"
	    "shadow_view_cargo"	"Shadow Volume - Cargo View"
	    "shadow_view_pilot"	"Shadow Volume - Pilot View"
	    "shadow_view_gunner"	"Shadow Volume - Gunner View"
	    "wreckage"	"Wreckage"
	    "underground"	"Underground (VBS)"
	    "groundlayer"	"Groundlayer (VBS)"
	    "navigation"	"Navigation (VBS)"
	    "unknown"	"Unknown"
	}
	help	"The kind of LOD. Resolution: Visual resolution; View - Gunner: Gunner first person view; View - Pilot: First person view; View - Cargo: Passenger first person view; Shadow Volume: Shadow casting geometry; Edit: Temporary layer; Geometry: Object collision geometry and occluders; Geometry Buoyancy: Buoyant object geometry (Displacement for VBS); Geometry PhysX: PhysX object collision geometry; Memory: Hard points and animation axes; Land Contact: Points of contact with ground; Roadway: Walkable surfaces; Paths: AI path finding mesh; Hit-points: Hit point cloud; View Geometry: View occlusion for AI; Fire Geometry: Hitbox geometry; View - Cargo Geometry: Passenger view collision geometry and occluders; View - Cargo Fire Geometry: Passenger view hitbox geometry; View - Commander: Commander first person view; View - Commander Geometry: Commander view collision geometry and occluders; View - Commander Fire Geometry: Commander hitbox geometry; View - Pilot Geometry: First person collision geometry and occluders; View - Pilot Fire Geometry: First person hitbox geometry; View - Gunner Geometry: Gunner collision geometry and occluders; View - Gunner Fire Geometry: Gunner view hitbox geometry; Sub Parts: Obsolete; Shadow Volume - Cargo View: Passenger view shadow casting geometry; Shadow Volume - Pilot View: First person view shadow casting geometry; Shadow Volume - Gunner View: Gunner view shadow casting geometry; Wreckage: Vehicle wreckage; Underground (VBS): Underground volume for VBS (not supported in Arma 3 -> Geometry PhysX Old); Groundlayer (VBS): Ground deformation data for VBS (not supported in Arma 3 -> Shadow Volume 3000); Navigation (VBS): Navigation data for VBS (not supported in Arma 3 -> Geometry / Resolution 5e+013); Unknown: Unknown model layer"
    }
    parm {
	name	"resolution"
	label	"Resolution"
	type	float
	size	1
	default	{ "1.0" }
	help	"The resolution or index. Only types that carry one use it. For Unknown it is the signature value."
    }
    parm {
	name	"propmode"
	label	"Property Mode"
	type	string
	default	{ "add" }
	menu {
	    "add"	"Add to Input"
	    "replace"	"Replace All"
	}
	help	"Add to input: the rows below are added, and a row with the same name (any case) replaces the input's entry. Replace all: only the rows below remain. LOD copies follow the same mode."
    }
    multiparm {
	name	"props"
	label	"Properties"
	default	0
	parmtag	{ "multistartoffset" "1" }

        parm {
    	name	"prop_name#"
    	label	"Name #"
    	type	string
    	default	{ "" }
        }

        parm {
    	name	"prop_value#"
    	label	"Value #"
    	type	string
    	default	{ "" }
        }
    }
    multiparm {
	name	"copies"
	label	"LOD Copies"
	default	0
	parmtag	{ "multistartoffset" "1" }

        parm {
    	name	"copy_type#"
    	label	"Copy Type #"
    	type	string
    	default	{ "visual" }
    	menu {
    	    "visual"	"Resolution"
    	    "view_gunner"	"View - Gunner"
    	    "view_pilot"	"View - Pilot"
    	    "view_cargo"	"View - Cargo"
    	    "shadow"	"Shadow Volume"
    	    "edit"	"Edit"
    	    "geometry"	"Geometry"
    	    "geometry_buoy"	"Geometry Buoyancy"
    	    "geometry_physx"	"Geometry PhysX"
    	    "memory"	"Memory"
    	    "landcontact"	"Land Contact"
    	    "roadway"	"Roadway"
    	    "paths"	"Paths"
    	    "hitpoints"	"Hit-points"
    	    "view_geometry"	"View Geometry"
    	    "fire_geometry"	"Fire Geometry"
    	    "view_cargo_geometry"	"View - Cargo Geometry"
    	    "view_cargo_fire_geometry"	"View - Cargo Fire Geometry"
    	    "view_commander"	"View - Commander"
    	    "view_commander_geometry"	"View - Commander Geometry"
    	    "view_commander_fire_geometry"	"View - Commander Fire Geometry"
    	    "view_pilot_geometry"	"View - Pilot Geometry"
    	    "view_pilot_fire_geometry"	"View - Pilot Fire Geometry"
    	    "view_gunner_geometry"	"View - Gunner Geometry"
    	    "view_gunner_fire_geometry"	"View - Gunner Fire Geometry"
    	    "subparts"	"Sub Parts"
    	    "shadow_view_cargo"	"Shadow Volume - Cargo View"
    	    "shadow_view_pilot"	"Shadow Volume - Pilot View"
    	    "shadow_view_gunner"	"Shadow Volume - Gunner View"
    	    "wreckage"	"Wreckage"
    	    "underground"	"Underground (VBS)"
    	    "groundlayer"	"Groundlayer (VBS)"
    	    "navigation"	"Navigation (VBS)"
    	    "unknown"	"Unknown"
    	}
        }

        parm {
    	name	"copy_res#"
    	label	"Copy Resolution #"
    	type	float
    	size	1
    	default	{ "1.0" }
        }
    }
}
