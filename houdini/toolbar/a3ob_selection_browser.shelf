<!-- houdiniArma3: the A3OB Selection browser shelf tool (ux-tools.md section 7.3). -->
<!-- It only calls into python/a3ob_houdini; the tool texts are for artists (a test checks them). -->
<shelfDocument>
  <toolshelf name="a3ob" label="A3OB">
    <memberTool name="a3ob_selection_browser"/>
    <memberTool name="a3ob_quick_export"/>
    <memberTool name="a3ob_new_p3d"/>
    <memberTool name="a3ob_batch_convert"/>
    <memberTool name="a3ob_project_settings"/>
    <memberTool name="a3ob_reload"/>
  </toolshelf>

  <tool name="a3ob_reload" label="Reload A3OB" icon="MISC_python">
    <helpText><![CDATA[Loads the A3OB code again after the package was updated, without restarting Houdini.]]></helpText>
    <script scriptType="python"><![CDATA[from a3ob_houdini import reload

reload.reload_all()]]></script>
  </tool>

  <tool name="a3ob_selection_browser" label="Selection browser" icon="MISC_python">
    <helpText><![CDATA[Lists the point groups of the selected SOP node by their P3D name. Copies an encoded name, or adds a Group, Group Delete or Group Rename node.]]></helpText>
    <script scriptType="python"><![CDATA[from a3ob_houdini import selection_browser_dialog

selection_browser_dialog.run(kwargs)]]></script>
  </tool>

  <tool name="a3ob_quick_export" label="Quick Export" icon="MISC_python">
    <helpText><![CDATA[Exports the selected SOP node (or the display node of the current network) to a .p3d file with a preset. Adds no node.]]></helpText>
    <script scriptType="python"><![CDATA[from a3ob_houdini import quick_export_dialog

quick_export_dialog.run(kwargs)]]></script>
  </tool>

  <tool name="a3ob_project_settings" label="Project root and presets" icon="MISC_python">
    <helpText><![CDATA[Sets the project root, picks, edits and deletes export presets, sets the common data file, and sets the Arma 3 Samples folder that the rigging nodes start from. Stored in one JSON file in the Houdini user preferences. Changes nothing in a scene.]]></helpText>
    <script scriptType="python"><![CDATA[from a3ob_houdini import project_settings_dialog

project_settings_dialog.run(kwargs)]]></script>
  </tool>

  <tool name="a3ob_new_p3d" label="New P3D" icon="MISC_python">
    <helpText><![CDATA[Builds the starter network (Resolution 1, Geometry and Memory LODs, Assemble LODs, P3D Export) in the open SOP network or in a new Geometry object.]]></helpText>
    <script scriptType="python"><![CDATA[from a3ob_houdini import new_p3d_dialog

new_p3d_dialog.run(kwargs)]]></script>
  </tool>

  <tool name="a3ob_batch_convert" label="Batch folder convert" icon="MISC_python">
    <helpText><![CDATA[Re-exports every .p3d in a folder with a preset into an output folder and writes a report: identical, different or failed for each file. The sources are never changed.]]></helpText>
    <script scriptType="python"><![CDATA[from a3ob_houdini import batch_convert_dialog

batch_convert_dialog.run(kwargs)]]></script>
  </tool>
</shelfDocument>
